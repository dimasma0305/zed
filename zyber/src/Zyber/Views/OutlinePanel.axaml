<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Zyber.Views" x:Class="Zyber.Views.OutlinePanel">
  <UserControl.Styles>
    <Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="32,Auto,*">
    <Grid ColumnDefinitions="*,28">
      <TextBox x:Name="Query" PlaceholderText="Search buffer symbols…" FontSize="13" BorderThickness="0,0,0,1" TextChanged="QueryChanged" />
      <Button x:Name="PinButton" Grid.Column="1" Classes="quiet" Padding="5,0" ToolTip.Tip="Pin this buffer" Click="PinClicked"><views:ZedIcon x:Name="PinIcon" Kind="pin" /></Button>
    </Grid>
    <TextBlock x:Name="Message" Grid.Row="1" Classes="muted" FontSize="12" Margin="10,8" TextWrapping="Wrap" IsVisible="False" />
    <TreeView x:Name="Symbols" Grid.Row="2" Background="Transparent" SelectionChanged="SymbolSelected" KeyDown="SymbolKeyDown">
      <TreeView.ItemTemplate><TreeDataTemplate DataType="views:OutlineNode" ItemsSource="{Binding Children}">
        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontFamily="avares://Zyber/Assets#Lilex" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
      </TreeDataTemplate></TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>
