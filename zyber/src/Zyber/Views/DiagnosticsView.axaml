<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Zyber.Views.DiagnosticsView">
  <Grid RowDefinitions="44,*" Background="{DynamicResource zed.editor.background}">
    <TextBlock Text="Project Diagnostics" Margin="12,0" VerticalAlignment="Center" />
    <ListBox x:Name="Results" Grid.Row="1" ItemsSource="{Binding Items}" DoubleTapped="OpenResult" KeyDown="ResultsKeyDown" Background="Transparent">
      <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Margin="6" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Severity}" /><TextBlock Text="{Binding Location}" Foreground="{DynamicResource zed.text.accent}" /></StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" />
        </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
